---

<section
  id="skills"
  aria-labelledby="skills-title"
  class="pt-16 md:pt-28 bg-background px-6 sm:px-12 lg:px-8"
>
  <div class="max-w-6xl mx-auto">
    <div class="mb-16 md:mb-24">
      <h2
        id="skills-title"
        class="text-foreground/90 font-sans text-[10px] tracking-[0.4em] uppercase mb-12 md:mb-15 lg:mb-18"
      >
        / Habilidades
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {
        categories.map((cat) => (
          <section
            aria-labelledby={`skill-category-${cat.label}`}
            class={`bg-card/5 border border-border/60 rounded-2xl p-6 md:p-8 flex flex-col skill-reveal hover:bg-card/10 transition-colors duration-500 ${cat.bentoClass}`}
          >
            <h3
              id={`skill-category-${cat.label}`}
              class="text-foreground/60 font-sans text-[11px] tracking-[0.3em] uppercase mb-8"
            >
              {cat.label}
            </h3>

            <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-auto-fit gap-4 mt-auto">
              {cat.skills.map((s) => (
                <li class="group flex flex-col items-center justify-center gap-3 p-4 rounded-xl bg-background border border-border/50 hover:border-foreground/30 hover:shadow-sm transition-all duration-300">
                  {/* Contenedor del Icono */}
                  <div
                    class="w-8 h-8 flex items-center text-foreground justify-center opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300"
                    aria-hidden="true"
                  >
                    {s.iconUrl ? (
                      <img
                        src={s.iconUrl}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-contain"
                      />
                    ) : s.key && IconMap[s.key] ? (
                      (() => {
                        const Icon = IconMap[s.key];
                        return <Icon />;
                      })()
                    ) : s.svgString ? (
                      <div
                        aria-hidden="true"
                        class="w-full h-full flex items-center justify-center [&>svg]:w-full [&>svg]:h-full"
                        set:html={s.svgString}
                      />
                    ) : null}
                  </div>

                  {/* Nombre */}
                  <span class="text-foreground/80 font-sans text-[12px] sm:text-[13px] font-medium group-hover:text-foreground transition-colors duration-200 text-center leading-tight">
                    {s.name}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid-cols-auto-fit {
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
  }

  .skill-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.7s ease-out,
      transform 0.7s ease-out;
  }

  .skill-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-reveal,
    .skill-reveal.visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const initSkillsObserver = () => {
    const observer = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("visible");
            observer.unobserve(e.target);
          }
        }),
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
    );

    document.querySelectorAll(".skill-reveal").forEach((el, i) => {
      (el as HTMLElement).style.transitionDelay = `${i * 0.1}s`;
      observer.observe(el);
    });
  };

  initSkillsObserver();
  document.addEventListener("astro:page-load", initSkillsObserver);
</script>
