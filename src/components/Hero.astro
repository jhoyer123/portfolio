---
import GitHub from "../components/icons/skills/Github.astro";
import Linkedin from "../components/icons/skills/Linkedin.astro";
import Download from "../components/icons/Download.astro";
---

<section
  id="start"
  aria-labelledby="hero-title"
  class="h-screen relative flex flex-col items-center justify-center overflow-hidden bg-background"
>
  <div
    class="z-20 flex flex-col gap-11 md:gap-6 items-center text-center w-full max-w-5xl px-6"
  >
    <div>
      <p
        class="text-foreground/90 font-hero font-light text-sm md:text-md lg:text-lg tracking-[0.8em] uppercase mb-1"
      >
        Jhoyer
      </p>
      <h1
        id="hero-title"
        class="text-foreground font-hero font-semibold text-[16vw] sm:text-[12vw] md:text-[9rem] leading-[0.85] tracking-tighter uppercase"
      >
        Vega G.
      </h1>
    </div>

    <p
      class="text-foreground/80 font-hero font-light text-xs md:text-lg tracking-[0.4em] uppercase"
    >
      Desarrollador Web Full Stack
    </p>

    <p
      class="text-foreground/80 font-hero font-light text-sm md:text-md lg:text-lg max-w-sm md:max-w-lg"
    >
      Transformando líneas de código en soluciones eficientes que impulsan el
      rendimiento y los objetivos empresariales.
    </p>

    <div
      class="flex flex-wrap gap-4 md:gap-6 lg:gap-15 items-center justify-center"
    >
      <a
        href="#about"
        aria-label="Ir a la sección Sobre mí"
        class="px-8 py-3.5 border border-btn-cv/30 bg-background/50 rounded-full text-xs font-light tracking-[0.15em] uppercase transition-all duration-300 hover:bg-foreground hover:text-background text-foreground backdrop-blur-md focus:outline-none focus:ring-2 focus:ring-white"
      >
        Sobre Mí
      </a>

      <a
        href="#projects"
        aria-label="Ir a la sección Proyectos"
        class="px-8 py-3.5 border border-btn-cv/30 bg-background/50 rounded-full text-xs font-light tracking-[0.15em] uppercase transition-all duration-300 hover:bg-foreground hover:text-background text-foreground backdrop-blur-md focus:outline-none focus:ring-2 focus:ring-white"
      >
        Proyectos
      </a>

      <div class="group z-10 absolute top-6.5 left-6  md:static">
        <a
          href="/JhoyerVegaGuarachi-cv.pdf"
          download="JhoyerVegaGuarachi-cv.pdf"
          aria-label="Descargar currículum vitae en PDF"
          class="flex gap-3 items-center justify-center px-5 py-2 md:px-8 md:py-3.5 border border-btn-cv/30 bg-background/50 rounded-full text-xs font-light tracking-[0.15em] uppercase transition-all duration-300 hover:bg-foreground hover:text-background text-foreground backdrop-blur-md focus:outline-none focus:ring-2 focus:ring-white"
        >
          <div
            class="size-4 opacity-60 group-hover:opacity-100 transition-opacity animate-bounce"
            aria-hidden="true"
          >
            <Download />
          </div>

          <p class="my-auto mt-0.5">CV</p>
        </a>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-12 left-1/2 -translate-x-1/2 z-20 flex gap-10 items-center justify-center"
    aria-label="Redes sociales"
  >
    <div
      class="w-6 h-6 text-foreground/60 hover:text-foreground transition-colors duration-300"
    >
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://www.linkedin.com/in/jhoyer-vega-guarachi-431b24342/"
        aria-label="Visitar perfil de LinkedIn"
        class="block w-full h-full focus:outline-none focus:ring-2 focus:ring-white rounded-sm"
      >
        <span aria-hidden="true">
          <Linkedin />
        </span>
      </a>
    </div>

    <div
      class="w-6 h-6 text-foreground/60 hover:text-foreground transition-colors duration-300"
    >
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://github.com/jhoyer123"
        aria-label="Visitar perfil de GitHub"
        class="block w-full h-full focus:outline-none focus:ring-2 focus:ring-white rounded-sm"
      >
        <span aria-hidden="true">
          <GitHub />
        </span>
      </a>
    </div>
  </div>

  <!-- Desktop backgrounds -->
  <div
    class="hidden absolute inset-0 md:block z-0 opacity-30 mix-blend-luminosity"
    aria-hidden="true"
  >
    <img
      src="/assets/images/fondos/fondodesktop.webp"
      alt=""
      class="hero-dark hidden w-full h-full object-cover object-center contrast-125 brightness-75"
      loading="eager"
      decoding="async"
    />

    <img
      src="/assets/images/fondos/heroLigthDesktop.webp"
      alt=""
      class="hero-light w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- Mobile backgrounds -->
  <div
    class="absolute inset-0 md:hidden z-0 opacity-30 mix-blend-luminosity"
    aria-hidden="true"
  >
    <img
      src="/assets/images/fondos/fondoMobile.webp"
      alt=""
      class="hero-dark hidden w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
    />

    <img
      src="/assets/images/fondos/heroLigthMobile.webp"
      alt=""
      class="hero-light w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
  </div>
</section>
