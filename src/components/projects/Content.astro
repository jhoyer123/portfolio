---
import Carrusel from "../carrusel/Carrusel.astro";
import GitHub from "../icons/skills/Github.astro";
import Laboratory from "../icons/Laboratory.astro";
import type { Project } from "../Projects.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="flex flex-col gap-24 md:gap-32">
  {
    projects.map((p, index) => (
      <article
        aria-labelledby={`project-title-${index}`}
        class={`grid lg:grid-cols-12 gap-10 lg:gap-16 items-start project-item ${
          index % 2 !== 0 ? "lg:[&>*:first-child]:order-2" : ""
        }`}
      >
        <div
          class="lg:col-span-7 project-media w-full max-w-full overflow-hidden"
          aria-label={`Galería del proyecto ${p.title}`}
        >
          <div class="border border-border bg-card/20 overflow-hidden p-1.5 sm:p-2 rounded-sm">
            <Carrusel images={p.images} />
          </div>
        </div>

        <div class="lg:col-span-5 project-content pt-2">
          <div
            class="flex flex-wrap gap-2 mb-6"
            aria-label="Tecnologías utilizadas"
          >
            {p.tecnologies.map((t) => (
              <span class="px-3 py-1 border border-border text-foreground/65 font-sans text-[9px] sm:text-[10px] tracking-[0.2em] uppercase">
                {t}
              </span>
            ))}
          </div>

          <h3
            id={`project-title-${index}`}
            class="text-foreground font-sans text-2xl md:text-3xl font-medium tracking-tight mb-6"
          >
            {p.title}
          </h3>

          <p class="text-foreground/70 font-sans text-[14px] sm:text-[15px] leading-[1.9] font-light mb-8">
            {p.descripcion}
          </p>

          <ul
            class="flex flex-col gap-3 mb-10"
            aria-label="Características del proyecto"
          >
            {p.features?.map((feature) => (
              <li class="flex items-start gap-3 text-foreground/75 font-sans text-[13px] sm:text-[14px] leading-relaxed">
                <span class="text-foreground/40 mt-[2px]" aria-hidden="true">
                  ▹
                </span>

                <span>{feature}</span>
              </li>
            ))}
          </ul>

          {/* Acciones */}
          <div class="flex flex-wrap gap-4">
            {p.urlRepo && (
              <a
                aria-label={`Ver repositorio del proyecto ${p.title}`}
                href={p.urlRepo}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-3 border border-border px-5 py-3 text-foreground font-sans text-[10px] sm:text-[11px] tracking-[0.18em] uppercase hover:border-foreground/40 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-white rounded-sm"
              >
                <div
                  class="w-4 opacity-70 group-hover:opacity-100 transition-opacity"
                  aria-hidden="true"
                >
                  <GitHub />
                </div>
                Repositorio
              </a>
            )}

            {p.urlDemo && (
              <a
                aria-label={`Ver demo del proyecto ${p.title}`}
                href={p.urlDemo}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-3 border border-border px-5 py-3 text-foreground font-sans text-[10px] sm:text-[11px] tracking-[0.18em] uppercase hover:border-foreground/40 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-white rounded-sm"
              >
                <div
                  class="w-4 opacity-70 group-hover:opacity-100 transition-opacity"
                  aria-hidden="true"
                >
                  <Laboratory />
                </div>
                Demo
              </a>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>
